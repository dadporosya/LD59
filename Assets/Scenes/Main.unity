--- !u!114 &1137833717
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1137833714}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 11db3e387a95d9d4fb28eb39113f05b5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Talkable
  name: ???
  portrait: {fileID: -8407555342299441177, guid: b226fba082d437848af040636dd96139, type: 3}
  voiceClips:
  - {fileID: 8300000, guid: 4b5c4d2bc5b4a1f4aa239f9b3d4d18b8, type: 3}
  dialogueManager: {fileID: 0}
  simpleMonologues: []
  rawDialogues:
  - values:
    - initialized: 0
      speakerIsThis: 1
      overWriteValues: 0
      text: 'Hellooo there.

'
      initFromScriptableObject: 0
      speaker: {fileID: 0}
      speakerGameObject: {fileID: 0}
      speakerName: 
      speakerPortrait: {fileID: -8407555342299441177, guid: b226fba082d437848af040636dd96139, type: 3}
      _speakerVoiceClips:
      - {fileID: 8300000, guid: 4b5c4d2bc5b4a1f4aa239f9b3d4d18b8, type: 3}
      onNodeStart:
        m_PersistentCalls:
          m_Calls: []
      onNodeEnd:
        m_PersistentCalls:
          m_Calls: []
    - initialized: 0
      speakerIsThis: 1
      overWriteValues: 0
      text: 'I am feeling a bit talkative right now. <pause=0.3>How about you? <pause=0.3>How
        is the weather? <pause=0.3>Heeey, do you hear me?

'
      initFromScriptableObject: 0
      speaker: {fileID: 0}
      speakerGameObject: {fileID: 0}
      speakerName: 
      speakerPortrait: {fileID: -8407555342299441177, guid: b226fba082d437848af040636dd96139, type: 3}
      _speakerVoiceClips:
      - {fileID: 8300000, guid: 4b5c4d2bc5b4a1f4aa239f9b3d4d18b8, type: 3}
      onNodeStart:
        m_PersistentCalls:
          m_Calls: []
      onNodeEnd:
        m_PersistentCalls:
          m_Calls: []
    - initialized: 0
      speakerIsThis: 1
      overWriteValues: 0
      text: 'Haha, <pause=0.5>look at this buddy without a mouth.

'
      initFromScriptableObject: 0
      speaker: {fileID: 0}
      speakerGameObject: {fileID: 0}
      speakerName: 
      speakerPortrait: {fileID: -1456289274, guid: b226fba082d437848af040636dd96139, type: 3}
      _speakerVoiceClips:
      - {fileID: 8300000, guid: 4b5c4d2bc5b4a1f4aa239f9b3d4d18b8, type: 3}
      onNodeStart:
        m_PersistentCalls:
          m_Calls: []
      onNodeEnd:
        m_PersistentCalls:
          m_Calls: []
    - initialized: 0
      speakerIsThis: 1
      overWriteValues: 0
      text: 'Next time, you would think twice before saying things like you said
        to me that day.

'
      initFromScriptableObject: 0
      speaker: {fileID: 0}
      speakerGameObject: {fileID: 0}
      speakerName: 
      speakerPortrait: {fileID: -1456289274, guid: b226fba082d437848af040636dd96139, type: 3}
      _speakerVoiceClips:
      - {fileID: 8300000, guid: 4b5c4d2bc5b4a1f4aa239f9b3d4d18b8, type: 3}
      onNodeStart:
        m_PersistentCalls:
          m_Calls: []
      onNodeEnd:
        m_PersistentCalls:
          m_Calls: []
    - initialized: 0
      speakerIsThis: 1
      overWriteValues: 0
      text: 'Okay, <pause=0.3>up to the point. '
      initFromScriptableObject: 0
      speaker: {fileID: 0}
      speakerGameObject: {fileID: 0}
      speakerName: 
      speakerPortrait: {fileID: -1496662183, guid: b226fba082d437848af040636dd96139, type: 3}
      _speakerVoiceClips: []
      onNodeStart:
        m_PersistentCalls:
          m_Calls: []
      onNodeEnd:
        m_PersistentCalls:
          m_Calls: []
    - initialized: 0
      speakerIsThis: 1
      overWriteValues: 0
      text: 'I decided to do some experiments, you know.

'
      initFromScriptableObject: 0
      speaker: {fileID: 0}
      speakerGameObject: {fileID: 0}
      speakerName: 
      speakerPortrait: {fileID: -8407555342299441177, guid: b226fba082d437848af040636dd96139, type: 3}
      _speakerVoiceClips: []
      onNodeStart:
        m_PersistentCalls:
          m_Calls: []
      onNodeEnd:
        m_PersistentCalls:
          m_Calls: []
    - initialized: 0
      speakerIsThis: 1
      overWriteValues: 0
      text: 'So, at first, try to push your blood. <pause=0.3>Just THINK OF IT <pause=0.5>(press
        button "1")

'
      initFromScriptableObject: 0
      speaker: {fileID: 0}
      speakerGameObject: {fileID: 0}
      speakerName: 
      speakerPortrait: {fileID: -8407555342299441177, guid: b226fba082d437848af040636dd96139, type: 3}
      _speakerVoiceClips: []
      onNodeStart:
        m_PersistentCalls:
          m_Calls:
          - m_Target: {fileID: 1676382161}
            m_TargetAssemblyTypeName: GameFlowManager, Assembly-CSharp
            m_MethodName: SetOnGame
            m_Mode: 1
            m_Arguments:
              m_ObjectArgument: {fileID: 0}
              m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
              m_IntArgument: 0
              m_FloatArgument: 0
              m_StringArgument: 
              m_BoolArgument: 0
            m_CallState: 2
      onNodeEnd:
        m_PersistentCalls:
          m_Calls: []
    - initialized: 0
      speakerIsThis: 1
      overWriteValues: 0
      text: 'Okay, once your heart stops, you will not be alive, <pause=0.3>understood? '
      initFromScriptableObject: 0
      speaker: {fileID: 0}
      speakerGameObject: {fileID: 0}
      speakerName: 
      speakerPortrait: {fileID: -1466364332, guid: b226fba082d437848af040636dd96139, type: 3}
      _speakerVoiceClips: []
      onNodeStart:
        m_PersistentCalls:
          m_Calls: []
      onNodeEnd:
        m_PersistentCalls:
          m_Calls: []
    - initialized: 0
      speakerIsThis: 1
      overWriteValues: 0
      text: 'Okay then, try to strain your brain and develop some new neurons <pause=0.5>(button
        2).

'
      initFromScriptableObject: 0
      speaker: {fileID: 0}
      speakerGameObject: {fileID: 0}
      speakerName: 
      speakerPortrait: {fileID: -8407555342299441177, guid: b226fba082d437848af040636dd96139, type: 3}
      _speakerVoiceClips: []
      onNodeStart:
        m_PersistentCalls:
          m_Calls: []
      onNodeEnd:
        m_PersistentCalls:
          m_Calls: []
    - initialized: 0
      speakerIsThis: 1
      overWriteValues: 0
      text: 'Here we go. <pause=0.2>At last, try to move yourself a bit <pause=0.5>(button
        3).



'
      initFromScriptableObject: 0
      speaker: {fileID: 0}
      speakerGameObject: {fileID: 0}
      speakerName: 
      speakerPortrait: {fileID: -1466364332, guid: b226fba082d437848af040636dd96139, type: 3}
      _speakerVoiceClips: []
      onNodeStart:
        m_PersistentCalls:
          m_Calls: []
      onNodeEnd:
        m_PersistentCalls:
          m_Calls: []
    - initialized: 0
      speakerIsThis: 1
      overWriteValues: 0
      text: 'Okay then, good job, jerk. Now, try to pass some distance on your own,
        okay? '
      initFromScriptableObject: 0
      speaker: {fileID: 0}
      speakerGameObject: {fileID: 0}
      speakerName: 
      speakerPortrait: {fileID: -8407555342299441177, guid: b226fba082d437848af040636dd96139, type: 3}
      _speakerVoiceClips: []
      onNodeStart:
        m_PersistentCalls:
          m_Calls: []
      onNodeEnd:
        m_PersistentCalls:
          m_Calls: []
    - initialized: 0
      speakerIsThis: 1
      overWriteValues: 0
      text: 'Oh yeah, there are some dudes of mine nearby. Just try to punch them
        or just run away, idk. Good luck.

'
      initFromScriptableObject: 0
      speaker: {fileID: 0}
      speakerGameObject: {fileID: 0}
      speakerName: 
      speakerPortrait: {fileID: -1456289274, guid: b226fba082d437848af040636dd96139, type: 3}
      _speakerVoiceClips: []
      onNodeStart:
        m_PersistentCalls:
          m_Calls: []
      onNodeEnd:
        m_PersistentCalls:
          m_Calls: []
  - values:
    - initialized: 0
      speakerIsThis: 1
      overWriteValues: 0
      text: "I hadn\u2019t thought you would manage to go so far.\r\n"
      initFromScriptableObject: 0
      speaker: {fileID: 0}
      speakerGameObject: {fileID: 0}
      speakerName: 
      speakerPortrait: {fileID: -1496662183, guid: b226fba082d437848af040636dd96139, type: 3}
      _speakerVoiceClips: []
      onNodeStart:
        m_PersistentCalls:
          m_Calls: []
      onNodeEnd:
        m_PersistentCalls:
          m_Calls: []
    - initialized: 0
      speakerIsThis: 1
      overWriteValues: 0
      text: ' Okay, now you may relax and stop.'
      initFromScriptableObject: 0
      speaker: {fileID: 0}
      speakerGameObject: {fileID: 0}
      speakerName: 
      speakerPortrait: {fileID: -1466364332, guid: b226fba082d437848af040636dd96139, type: 3}
      _speakerVoiceClips: []
      onNodeStart:
        m_PersistentCalls:
          m_Calls: []
      onNodeEnd:
        m_PersistentCalls:
          m_Calls: []
  - values:
    - initialized: 0
      speakerIsThis: 1
      overWriteValues: 0
      text: DIDN'T I TELL YOU TO STOP?
      initFromScriptableObject: 0
      speaker: {fileID: 0}
      speakerGameObject: {fileID: 0}
      speakerName: 
      speakerPortrait: {fileID: -1466364332, guid: b226fba082d437848af040636dd96139, type: 3}
      _speakerVoiceClips: []
      onNodeStart:
        m_PersistentCalls:
          m_Calls: []
      onNodeEnd:
        m_PersistentCalls:
          m_Calls: []
    - initialized: 0
      speakerIsThis: 1
      overWriteValues: 0
      text: YOU HAVE NO EARS TOO, SEE
      initFromScriptableObject: 0
      speaker: {fileID: 0}
      speakerGameObject: {fileID: 0}
      speakerName: 
      speakerPortrait: {fileID: -1466364332, guid: b226fba082d437848af040636dd96139, type: 3}
      _speakerVoiceClips: []
      onNodeStart:
        m_PersistentCalls:
          m_Calls: []
      onNodeEnd:
        m_PersistentCalls:
          m_Calls: []
    - initialized: 0
      speakerIsThis: 1
      overWriteValues: 0
      text: 'DON''T YOU EVEN LISTEN? <pause=0.3>Ah, yeah...

'
      initFromScriptableObject: 0
      speaker: {fileID: 0}
      speakerGameObject: {fileID: 0}
      speakerName: 
      speakerPortrait: {fileID: -1496662183, guid: b226fba082d437848af040636dd96139, type: 3}
      _speakerVoiceClips: []
      onNodeStart:
        m_PersistentCalls:
          m_Calls: []
      onNodeEnd:
        m_PersistentCalls:
          m_Calls: []
  - values:
